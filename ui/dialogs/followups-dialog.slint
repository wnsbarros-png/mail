import { ScrollView } from "std-widgets.slint";
import { Button } from "../components/button.slint";
import { LineEdit } from "../components/controls.slint";
export struct FollowupRow {id:int,subject:string,due:string,state:string,active:bool,can-propose:bool}
export component FollowupsDialog inherits Rectangle {
 in-out property <string> message;
 in-out property <string> days:"3";
 in-out property <string> template;
 in property <[FollowupRow]> rows;
 in property <string> status;
 in property <bool> busy;
 callback command(string,int);
 callback close;
 background:#f8fafc;border-radius:12px;
 VerticalLayout {padding:20px;spacing:12px;
  HorizontalLayout {Text {text:@tr("Follow-up reminders");font-size:24px;color:#172033;vertical-alignment:center;}Button {width:90px;horizontal-stretch:0;text:@tr("Close");clicked=>{root.close();}}}
  Text {text:@tr("Select an actually sent message, then wait for a reply. Reminders never send mail automatically. The app must be open; overdue reminders appear after restart.");wrap:word-wrap;color:#334155;}
  Text {text:@tr("Templates: create, edit or delete in Compose, Templates. Variables use {{{{nome}}}}, {{{{valor}}}}, {{{{data}}}}, {{{{vencimento}}}}, {{{{empresa}}}}, {{{{assinatura}}}} or custom names. Configure signatures per account in Settings.");wrap:word-wrap;color:#475569;}
  HorizontalLayout {spacing:8px;Text {text:@tr("Sent message ID");vertical-alignment:center;}LineEdit {text<=>root.message;width:100px;}Button {text:@tr("Use selected message");enabled:!root.busy;clicked=>{root.command("selected",0);}}Text {text:@tr("Days (1–365)");vertical-alignment:center;}LineEdit {text<=>root.days;width:65px;}}
  HorizontalLayout {spacing:8px;Text {text:@tr("Optional template ID");vertical-alignment:center;}LineEdit {text<=>root.template;width:100px;}Button {text:@tr("Wait for reply");enabled:!root.busy;clicked=>{root.command("set",0);}}Button {text:@tr("Refresh");enabled:!root.busy;clicked=>{root.command("refresh",0);}}}
  Text {text:root.status;wrap:word-wrap;color:#475569;}
  Rectangle {height:1px;background:#cbd5e1;}
  ScrollView {vertical-stretch:1;content-width:self.width;
   VerticalLayout {spacing:8px;
    for row in root.rows:Rectangle {height:108px;background:#ffffff;border-width:1px;border-color:#cbd5e1;border-radius:8px;
     VerticalLayout {padding:10px;spacing:5px;
      Text {text:row.subject;overflow:elide;color:#172033;font-weight:600;}
      Text {text:row.state+" · "+row.due;overflow:elide;color:#475569;}
      HorizontalLayout {spacing:8px;Button {text:@tr("Prepare polite follow-up");enabled:!root.busy&&row.can-propose;clicked=>{root.command("propose",row.id);}}Button {text:@tr("Cancel reminder");enabled:!root.busy&&row.active;clicked=>{root.command("cancel",row.id);}}}
     }
    }
   }
  }
  Text {text:@tr("Prepare creates a proposal for the app approval panel, never an automatic send. Original To/Cc recipients are retained; Bcc is not reused. Custom templates with missing variables must be filled in Compose.");wrap:word-wrap;color:#475569;}
 }
}
